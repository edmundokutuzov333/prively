{
  "name": "prively",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:supabase-config": "node scripts/check-supabase-config.mjs",
    "check:phase10": "node scripts/check-phase10.mjs",
    "vercel:build": "npm run build",
    "audit:production": "node scripts/production-audit.mjs",
    "e2e": "playwright test --grep-invert \"production-smoke\"",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.5",
    "@hookform/resolvers": "^5.1.3",
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.90.16",
    "blurhash": "^2.0.5",
    "i18next": "^25.5.2",
    "livekit-client": "^2.22.3",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.9.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^26.1.0",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
